# ---------------------------------------------------------------------------
# Alisha Tours & Travels — environment variables
#
# Local development:  copy this file to .env.local and fill in real values.
# Production:         set the same keys in DigitalOcean App Platform →
#                     your app → Settings → App-Level Environment Variables.
#                     Mark every secret (anything that is not NEXT_PUBLIC_*)
#                     as "Encrypted".
# Never commit .env.local.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# MongoDB Atlas connection string, including the database name.
# On App Platform, add 0.0.0.0/0 to the Atlas IP allowlist (App Platform does
# not publish static outbound IPs on the basic tiers) or use a VPC peering.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/alisha?retryWrites=true&w=majority"

# --- Media (Cloudinary) ----------------------------------------------------
# Either provide CLOUDINARY_URL on its own...
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
# ...or the three parts separately (leave CLOUDINARY_URL blank if you do).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Transactional e-mail (Resend) -----------------------------------------
# Sending domain must be verified in Resend: alishatravels.in
# See README > E-mail for the DNS records required.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# The From: address. Must be on a verified domain.
ENQUIRY_FROM_EMAIL="Alisha Tours & Travels <enquiries@alishatravels.in>"
# Where enquiry notifications land. Comma-separate for multiple recipients.
ENQUIRY_TO_EMAIL="info@alishatravels.in"

# --- Auth ------------------------------------------------------------------
# Signs the admin session cookie. Generate with:  openssl rand -base64 48
AUTH_SECRET=""

# --- Seed script (scripts/seed.js) -----------------------------------------
# Credentials for the initial admin account. Change the password immediately
# after the first login. The seed script prints these once and never again.
SEED_ADMIN_NAME="Alisha Admin"
SEED_ADMIN_EMAIL="admin@alishatravels.in"
SEED_ADMIN_PASSWORD=""

# --- Public (exposed to the browser — never put secrets here) ---------------
# Canonical origin, used for canonical tags, sitemap.xml and structured data.
NEXT_PUBLIC_SITE_URL="https://alishatravels.in"
# wa.me format: country code + number, digits only, no + and no spaces.
NEXT_PUBLIC_WHATSAPP_NUMBER="919562921818"
# Legacy container, reused so historical analytics stay continuous.
# Only fires after the visitor accepts the cookie banner.
NEXT_PUBLIC_GTM_ID="GTM-NF9ST9W5"
